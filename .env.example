# Nusxa: cp .env.example .env  keyin qiymatlarni to‘ldiring.
# .env gitga kirmaydi — deployda DB_URL ni hosting panelida (Environment Variables) qo‘ying.

# --- Mahalliy Mongo (docker compose loyiha ildizidan) ---
DB_URL=mongodb://127.0.0.1:27017/icrich

# --- Production (Atlas yoki boshqa bulut) ---
